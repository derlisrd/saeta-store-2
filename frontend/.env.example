# URL base donde se publica el frontend (sin barra final)
VITE_BASE_URL=/admin

VITE_WEBSITE_NAME=Saeta
VITE_ICON=rocket
VITE_APP_NAME=Saeta Store

# Token local / JWT (se embebe en el bundle, no pongas secretos reales)
VITE_SECRETO=
VITE_X_API_TOKEN=

# Endpoint de la API
VITE_API_URL_END_POINT=/api/v1/

# Solo desarrollo: a dónde se proxyean /api/v1 y /uploads
VITE_DEV_API_PROXY=http://localhost:8080
